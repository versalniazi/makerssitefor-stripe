# Copy this file to .env.local and fill in your own values.
# .env.local is already gitignored — never commit real secret keys.

# Required to enable checkout (Cart -> "Proceed to Checkout").
# Get this from https://dashboard.stripe.com/apikeys — use a test-mode
# secret key (starts with sk_test_) until you're ready to go live.
STRIPE_SECRET_KEY=sk_test_...

# Used to build the Stripe success/cancel redirect URLs when the request
# has no Origin header (e.g. some server-to-server calls). Safe to leave
# as-is for local development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
